PORT=5000
NODE_ENV=development
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set this to a persistent path outside the checkout for deployments.
# DB_PATH=/var/lib/camoins/backhaul.db
# Production: terminate HTTPS at a trusted reverse proxy and restrict direct
# access to the Node port before enabling TRUST_PROXY.
TRUST_PROXY=false
